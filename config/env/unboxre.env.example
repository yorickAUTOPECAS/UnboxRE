# ============================================================================
#  UnboxRE — variáveis de ambiente de referência
# ============================================================================
#
#  Copie para `unboxre.env` (o health-check faz isso com -Fix-Paths) e ajuste
#  os caminhos da sua máquina. O arquivo real NÃO vai para o Git (.gitignore).
#
#  Como carregar
#  -------------
#  PowerShell (sessão atual):
#     Get-Content .\config\env\unboxre.env | Where-Object { $_ -match '^\s*[^#]' } |
#       ForEach-Object { $k,$v = $_ -split '=',2; [Environment]::SetEnvironmentVariable($k.Trim(), $v.Trim(), 'Process') }
#     # ou simplesmente:  . .\scripts\lib\load-env.ps1
#
#  Git Bash / WSL:
#     set -a; . ./config/env/unboxre.env; set +a
#
#  Regra: este arquivo contém APENAS caminhos e flags. Tokens e senhas nunca
#  entram aqui — vão para variáveis de sessão ou para o gerenciador do cliente.
# ============================================================================


# ────────────────────────────────────────────────────────────────────────────
#  1. Raiz do toolkit  (usada pelos scripts; quase todos derivam daqui)
# ────────────────────────────────────────────────────────────────────────────

# Caminho absoluto da raiz deste repositório. Se ficar vazio, os scripts
# descobrem sozinhos a partir da localização do próprio .ps1/.sh — preencher
# só é necessário quando você move binários para fora da árvore.
UNBOXRE_WORKSPACE=C:\Users\Admin\Desktop\UnboxRE

# Área de trabalho por alvo (amostras, dumps, traces). Fica FORA do Git porque
# contém binário de terceiros e, potencialmente, dado sensível de cliente.
UNBOXRE_WORK=work

# Diretório onde o bootstrap instala ferramentas novas (fora do PATH global,
# para não poluir o sistema e permitir remoção com um `rm -rf tools/<nome>`).
UNBOXRE_TOOLS=tools


# ────────────────────────────────────────────────────────────────────────────
#  2. Núcleo — Ghidra
# ────────────────────────────────────────────────────────────────────────────

# Instalação do Ghidra. Consumida pelo REA (integração Ghidra), pelos scripts
# de extensão e pelo analyzeHeadless. Precisa apontar para a pasta que contém
# `support/analyzeHeadless.bat` e `Ghidra/`.
GHIDRA_INSTALL_DIR=C:\Users\Admin\Desktop\UnboxRE\ghidra\ghidra_12.1.4_PUBLIC

# JDK usado pelo Ghidra. O Ghidra 12.x exige JDK 21+; use um JDK dedicado em
# vez do que vem com o Ghidra (permite atualizar o Ghidra sem perder o JDK).
JAVA_HOME=C:\Program Files\Java\jdk-21.0.12

# Memória máxima da JVM no modo headless. Análise de binários grandes (jogos,
# drivers) estoura o default de 1 GB. `-Xmx8g` é um bom ponto de partida.
# Formato livre: qualquer coisa que o Java aceite via -Xmx.
GHIDRA_MAXMEM=8G

# Diretório de projetos do Ghidra. Um projeto por alvo evita que uma análise
# corrompida derrube as demais. Os scripts usam work/<alvo>/ghidra-proj.
GHIDRA_PROJECT_DIR=work


# ────────────────────────────────────────────────────────────────────────────
#  3. Núcleo — x64dbg
# ────────────────────────────────────────────────────────────────────────────

# Snapshot do x64dbg (release). Usado para localizar plugins/, o launcher e
# para o re-build copiar o .dp64/.dp32 para o lugar certo.
X64DBG_ROOT=C:\Users\Admin\Desktop\UnboxRE\x64dbg\release

# Portas do plugin x64dbg-MCP. 9094 = instância x64, 9095 = instância x32.
# Mudar aqui exige mudar também x64dbg/mcp_config.json e a config do cliente.
X64DBG_MCP_PORT_X64=9094
X64DBG_MCP_PORT_X32=9095

# Token do x64dbg-MCP. Deixe VAZIO neste arquivo: o plugin gera o token no
# primeiro run e o grava em x64dbg/mcp_config.json. O health-check lê de lá.
# Preencha apenas em uma sessão shell, se precisar automatizar:
#   $env:X64DBG_TOKEN = (Get-Content .\x64dbg\mcp_config.json | ConvertFrom-Json).authToken
X64DBG_TOKEN=


# ────────────────────────────────────────────────────────────────────────────
#  4. Núcleo — REA (orquestrador por agente)
# ────────────────────────────────────────────────────────────────────────────

# Deixe vazio para o REA usar os defaults internos (ele lê GHIDRA_INSTALL_DIR).
REA_HOME=C:\Users\Admin\Desktop\UnboxRE\rea-main

# Provedor de modelo usado pelo REA. Ajuste conforme a chave que você tem.
# Valores típicos: openai | anthropic | local. Ver docs/07-operacao-por-ia.md.
REA_PROVIDER=anthropic

# Chave do provedor. NUNCA neste arquivo — exporte na sessão:
#   $env:REA_API_KEY = '...'
# O REA também aceita a chave vinda do ambiente do cliente MCP.
REA_API_KEY=


# ────────────────────────────────────────────────────────────────────────────
#  5. Ferramentas do catálogo (caminhos não-PATH)
# ────────────────────────────────────────────────────────────────────────────
#  Só preencha o que estiver em local não padrão. Comentado = "descubra no PATH".

# radare2 / rizin — raiz da instalação (contém bin/r2)
#R2_HOME=C:\Users\Admin\Desktop\UnboxRE\tools\radare2
#RIZIN_HOME=C:\Users\Admin\Desktop\UnboxRE\tools\rizin

# Detect It Easy — pasta do diec.exe (para o script de triagem automática)
#DIEC_HOME=C:\Users\Admin\Desktop\UnboxRE\tools\detect-it-easy

# YARA — regras próprias + as comunitárias
#YARA_RULES=%UNBOXRE_WORKSPACE%\rules\yara

# capa — binário ou `pip install flare-capa`
#CAPA_PATH=

# Frida — servidor para alvo remoto/Android
#FRIDA_SERVER_PATH=

# Wireshark/tshark — em Windows costuma já estar em Program Files
#TSHARK_PATH=C:\Program Files\Wireshark\tshark.exe

# mitmproxy — diretório de trabalho (certificados, addons, flows salvos)
#MITMPROXY_CONFDIR=%USERPROFILE%\.mitmproxy

# Android SDK / emulador (análise dinâmica de APK)
#ANDROID_SDK_ROOT=%LOCALAPPDATA%\Android\Sdk

# WSL — distro usada para o toolchain Linux (ELF, pwndbg, unblob)
UNBOXRE_WSL_DISTRO=Ubuntu


# ────────────────────────────────────────────────────────────────────────────
#  6. Comportamento dos scripts
# ────────────────────────────────────────────────────────────────────────────

# Verbosidade: 0 silencioso · 1 normal · 2 detalhado (mostra cada comando)
UNBOXRE_VERBOSE=1

# Rede: proxy corporativo, se houver. Usado por bootstrap e downloads.
#HTTPS_PROXY=http://proxy.corp:8080
